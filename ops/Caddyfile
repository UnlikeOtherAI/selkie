{
  # Defense-in-depth (Caddy 2.7+): only honor X-Forwarded-For from peers
  # inside private_ranges, and have Caddy overwrite the outgoing XFF with
  # its own trusted view of the chain before proxying upstream. This
  # prevents a client-supplied XFF from reaching the Go server even if the
  # rightmost-non-trusted walk in internal/audit.ClientIP regresses.
  servers {
    trusted_proxies static private_ranges
    client_ip_headers X-Forwarded-For
  }
}

(selkie_edge) {
  encode zstd gzip

  header {
    # HSTS without `preload` until the domain is actually submitted to the
    # browser preload list — claiming preload without registration is a
    # footgun if the cert ever lapses on a subdomain.
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Self-host fonts (the admin UI must drop Google Fonts dependencies in
    # its build pipeline). Removing fonts.googleapis.com / fonts.gstatic.com
    # from CSP closes a future-XSS exfiltration vector through query params.
    Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
    Cross-Origin-Resource-Policy "same-origin"
    Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  }

  @device_events path_regexp device_events ^/api/v1/devices/[^/]+/events$
  handle @device_events {
    reverse_proxy 127.0.0.1:{$SERVER_PORT:8080} {
      trusted_proxies private_ranges
      flush_interval -1
    }
  }

  reverse_proxy 127.0.0.1:{$SERVER_PORT:8080} {
    trusted_proxies private_ranges
  }
}

{$ADMIN_HOST} {
  import selkie_edge
}

{$API_HOST} {
  import selkie_edge
}
