{
  # Defense-in-depth (Caddy 2.7+): only honor X-Forwarded-For from peers
  # inside private_ranges, and have Caddy overwrite the outgoing XFF with
  # its own trusted view of the chain before proxying upstream. This
  # prevents a client-supplied XFF from reaching the Go server even if the
  # rightmost-non-trusted walk in internal/audit.ClientIP regresses.
  servers {
    trusted_proxies static private_ranges
    client_ip_headers X-Forwarded-For
  }
}

# Shared edge concerns: HSTS, anti-MIME-sniff, encoding, reverse-proxy
# wiring. Headers that only make sense for an HTML origin (CSP, COOP/COEP,
# X-Frame-Options, Permissions-Policy) live in selkie_admin_headers and are
# applied only to the admin host. Applying COEP=require-corp +
# CORP=same-origin to the JSON API host blocks the admin SPA from reading
# cross-origin API responses in a browser.
(selkie_edge_common) {
  encode zstd gzip

  header {
    # HSTS without `preload` until the domain is actually submitted to the
    # browser preload list — claiming preload without registration is a
    # footgun if the cert ever lapses on a subdomain. See docs/security.md
    # for the current submission status.
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
  }

  @device_events path_regexp device_events ^/api/v1/devices/[^/]+/events$
  handle @device_events {
    reverse_proxy 127.0.0.1:{$SERVER_PORT:8080} {
      trusted_proxies private_ranges
      flush_interval -1
    }
  }

  reverse_proxy 127.0.0.1:{$SERVER_PORT:8080} {
    trusted_proxies private_ranges
  }
}

# Admin-host browser hardening. IBM Plex is self-hosted via @fontsource
# (admin-ui/src/main.tsx), so fonts.googleapis.com is no longer in
# style-src/font-src. The user avatar is loaded with crossorigin="anonymous"
# from *.googleusercontent.com, which satisfies COEP=require-corp via CORS.
# interest-cohort=() omitted: FLoC was retired in 2023; modern Chromium
# uses Topics API, which would be opted-out via browsing-topics=() if needed.
(selkie_admin_headers) {
  header {
    Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.googleusercontent.com; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    X-Frame-Options "DENY"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
    Cross-Origin-Resource-Policy "same-origin"
    Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  }
}

# API-host headers: the JSON API serves no HTML so CSP/COOP/COEP have no
# document to isolate. CORP=cross-origin lets the admin SPA on a different
# host read API responses while still preventing accidental data inclusion
# via <script src=…>.
(selkie_api_headers) {
  header {
    Cross-Origin-Resource-Policy "cross-origin"
  }
}

{$ADMIN_HOST} {
  import selkie_edge_common
  import selkie_admin_headers
}

{$API_HOST} {
  import selkie_edge_common
  import selkie_api_headers
}
